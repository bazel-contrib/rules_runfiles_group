"""Construction of a validated runfiles group entry."""

load("//runfiles_group/private/providers:runfiles_group_info.bzl", "RunfilesGroupInfo")

def check_metadata(
    where: str,
    field: Literal["name", "kind", "rank", "do_not_merge", "weight", "merge_affinity"],
    value: object,
) -> None: ...

def check_entry(where: str, entry: object) -> None: ...

def make_entry(
    *,
    name: Label | str,
    content: depset[File] | runfiles,
    kind: str = ...,
    rank: int = ...,
    do_not_merge: bool = ...,
    weight: int | None = ...,
    merge_affinity: str = ...,
) -> RunfilesGroupInfo: ...
