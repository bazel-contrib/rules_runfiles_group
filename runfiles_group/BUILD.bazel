load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

bool_flag(
    name = "enabled",
    build_setting_default = False,
    deprecation = """\
This was a global option to enable/disable RunfileGroupInfo.
Collection is now done on-demand using an aspect, so this is effectively a no-op.""",
    visibility = ["//visibility:public"],
)

exports_files(
    srcs = [
        "identity_packager.bzl",
        "lib.bzl",
        "providers.bzl",
        "runfiles_group_analysis_test.bzl",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//runfiles_group/private/providers:runfiles_group_describer_info",
        "//runfiles_group/private/providers:runfiles_group_info",
        "//runfiles_group/private/providers:runfiles_group_partial_info",
        "//runfiles_group/private/providers:runfiles_group_transform_info",
    ],
)

bzl_library(
    name = "identity_packager",
    srcs = ["identity_packager.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//runfiles_group/private/aspects:identity"],
)

bzl_library(
    name = "lib",
    srcs = ["lib.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//runfiles_group/private:lib",
    ],
)

bzl_library(
    name = "runfiles_group_analysis_test",
    srcs = ["runfiles_group_analysis_test.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//runfiles_group/private/rules:runfiles_group_analysis_test",
    ],
)
