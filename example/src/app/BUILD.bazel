load("@rules_runfiles_group//runfiles_group:runfiles_group_analysis_test.bzl", "runfiles_group_analysis_test")
load("//producer/rules:foreign_plugin.bzl", "foreign_plugin")
load("//producer/rules:starlark_app.bzl", "HAS_LABEL_LIST_DICT", "starlark_app")
load("//producer/rules:starlark_binary.bzl", "starlark_binary")
load("//producer/rules:starlark_library.bzl", "starlark_library")

P = "starlark_runfiles_group#"

starlark_library(
    name = "core",
    srcs = ["core.star"],
)

starlark_library(
    name = "util",
    srcs = ["util.star"],
)

starlark_library(
    name = "plugin_greet",
    srcs = ["plugin_greet.star"],
)

starlark_library(
    name = "plugin_clock",
    srcs = ["plugin_clock.star"],
)

starlark_library(
    name = "vendored_json",
    srcs = ["vendored_json.star"],
)

starlark_library(
    name = "feature_units",
    srcs = ["feature_units.star"],
)

# From a ruleset that does not describe its runfiles groups. Its outputs include a
# build report it does not need at runtime; starlark_app's own fallback leaves that
# report out of the plugin's group, which the completeness check below pins.
foreign_plugin(
    name = "telemetry_plugin",
)

starlark_app(
    name = "demo_app",
    data = ["registry_defaults.json"],
    main = ":core",
    optional_features = {"units": [":feature_units"]},
    pinned_versions = {":vendored_json": "2.14.0"},
    plugins = {
        "clock": ":plugin_clock",
        "greet": ":plugin_greet",
    },
    runtime_plugins = [":telemetry_plugin"],
    # plugin_clock is registered as a plugin above as well. A library reached
    # through two attributes propagates the same partials twice and must still
    # end up in exactly one group, which overlapping_group_behavior = "error"
    # checks.
    deps = [
        ":plugin_clock",
        ":util",
    ],
)

starlark_binary(
    name = "demo",
    src = "main.star",
    runfiles_grouping = "by_target",
    deps = [":demo_app"],
)

# One group per target reached through the app, all of them in this repository and
# therefore at the same rank -- so they are ordered by Label, which for one package
# is the target name. attr.label_list_dict is Bazel 9 and newer; on 7 and 8 the app
# has no optional_features attribute and never reaches feature_units (see
# starlark_app.bzl), so its group is expected only where the attribute exists.
runfiles_group_analysis_test(
    name = "test_demo_groups",
    binaries = [":demo"],
    expected_executable_group = P + "entrypoint",
    expected_group_names = [
        P + "interpreter",
        P + "std",
    ] + sorted([
        "@@//src/app:core",
        "@@//src/app:demo_app",
        "@@//src/app:plugin_clock",
        "@@//src/app:plugin_greet",
        "@@//src/app:registry_defaults.json",
        "@@//src/app:telemetry_plugin",
        "@@//src/app:util",
        "@@//src/app:vendored_json",
    ] + (["@@//src/app:feature_units"] if HAS_LABEL_LIST_DICT else [])) + [
        P + "entrypoint",
    ],
    overlapping_group_behavior = "error",
)
