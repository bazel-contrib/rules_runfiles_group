load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//producer/rules:starlark_toolchain.bzl", "starlark_toolchain")

go_library(
    name = "interpreter_lib",
    srcs = ["main.go"],
    importpath = "example/producer/interpreter",
    visibility = ["//visibility:private"],
    deps = [
        "@net_starlark_go//starlark",
        "@net_starlark_go//syntax",
        "@rules_go//go/runfiles",
    ],
)

go_binary(
    name = "interpreter",
    embed = [":interpreter_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

starlark_toolchain(
    name = "starlark_toolchain",
    interpreter = ":interpreter",
    standard_library = "@std",
)

toolchain(
    name = "toolchain",
    toolchain = ":starlark_toolchain",
    toolchain_type = ":toolchain_type",
)
